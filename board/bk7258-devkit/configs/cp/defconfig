# Cross-core networking, Vela standard: the AP connects back to this core
# through PF_RPMSG sockets; this core runs the listening side and owns
# wlan0/NAT.  NET_RPMSG_DRV was abandoned (symmetric-create deadlock).
CONFIG_NET_RPMSG=y
CONFIG_EXAMPLES_RPMSGSOCKET=y
# usrsock server: the AP's sockets execute on this core (NET_USRSOCK_RPMSG_SERVER,
# initialized by drivers_initialize), which owns wlan0. Vela-standard cross-core
# networking, mirroring the sim rpserver/rpproxy reference pair.
CONFIG_NET_USRSOCK_RPMSG_SERVER=y
