############################################################################
# chips/bk7258/wifi/Make.defs
#
# BK7258 Wi-Fi skeleton component (legacy Make build).
############################################################################

ifeq ($(CONFIG_BK7258_WIFI),y)

CHIP_CSRCS += bk7258_wifi_lower.c
CHIP_CSRCS += bk7258_wifi_osal.c
CHIP_CSRCS += bk7258_wifi_packet.c
CHIP_CSRCS += glue/pbuf_shim.c
CHIP_CSRCS += bk7258_wifi_hw.c
CHIP_CSRCS += bk7258_wifi_adapter.c
CHIP_CSRCS += glue/hw_driver_shim.c
CHIP_CSRCS += glue/bk7258_saradc.c
CHIP_CSRCS += glue/netif_shim.c
CHIP_CSRCS += glue/system_shim.c
CHIP_CSRCS += glue/rtos_ext_shim.c
CHIP_CSRCS += glue/rtos_compat_shim.c
CHIP_CSRCS += glue/bk_workqueue_nuttx.c
CHIP_CSRCS += glue/phy_calibration_shim.c
CHIP_CSRCS += glue/analog_shim.c
CHIP_CSRCS += glue/feature_shim.c
CHIP_CSRCS += glue/flash_shim.c
CHIP_CSRCS += glue/misc_shim.c
CHIP_CSRCS += glue/event_shim.c
CHIP_CSRCS += glue/scan_diagnostics.c
CHIP_CSRCS += glue/platform_shim.c
CHIP_CSRCS += glue/os_shim.c
CHIP_CSRCS += glue/net_param_shim.c
CHIP_CSRCS += glue/vendor_sources/rwnx_params.c
CHIP_CSRCS += glue/vendor_sources/rwnx_td.c
CHIP_CSRCS += glue/vendor_sources/rwnx_txq.c
# VIF/STA index helpers referenced by rw_task.c, rwnx_tx.c and rwnx_rx.c.
CHIP_CSRCS += glue/vendor_sources/rwnx_utils.c
# Monitor callback registry + management-frame filter, backing rwnx_rx.c
# (wifi_monitor_get_cb) and libwifi.a's rxl_cntrl (rx_mgmt_filter).
CHIP_CSRCS += glue/vendor_sources/lsig_monitor.c
CHIP_CSRCS += glue/vendor_sources/rw_ieee80211.c
CHIP_CSRCS += glue/vendor_sources/rwnx_tx.c
CHIP_CSRCS += glue/vendor_sources/rwnx_rx.c
CHIP_CSRCS += glue/vendor_sources/rw_task.c
CHIP_CSRCS += glue/vendor_sources/wifi_v2.c
CHIP_CSRCS += glue/vendor_sources/wifi_config.c
CHIP_CSRCS += glue/vendor_sources/net_param.c
CHIP_CSRCS += glue/vendor_sources/rw_msg_tx.c
CHIP_CSRCS += glue/vendor_sources/rw_msg_rx.c
CHIP_CSRCS += glue/vendor_sources/wifi_init.c
CHIP_CSRCS += glue/vendor_sources/bk_phy_adapter.c
CHIP_CSRCS += third_party/beken_armino/board/bk7258/vnd_cal/vnd_cal.c
CHIP_CSRCS += glue/vendor_sources/skbuff.c

ifeq ($(CONFIG_BK7258_WIFI_VENDOR_RUNTIME),y)
CHIP_CSRCS += glue/vendor_sources/fake_socket.c
CHIP_CSRCS += glue/vendor_sources/eloop.c
CHIP_CSRCS += glue/vendor_sources/wpa_signal.c
CHIP_CSRCS += glue/vendor_sources/sk_intf.c
# WPA <-> MAC ioctl bridge and its transport; STA providers, runtime-only
# because they depend on the WPA socket contract.
CHIP_CSRCS += glue/vendor_sources/ddrv.c
CHIP_CSRCS += glue/vendor_sources/hostapd_intf.c
# STA association command, called by hostapd_intf.c (wpa_send_assoc_req).
CHIP_CSRCS += glue/vendor_sources/sa_station.c
# Team-owned WPA handler queue object + accessors (upstream keeps these in
# hostapd/main_none.c, which would pull in the whole hostapd closure).
CHIP_CSRCS += glue/wpa_queue_shim.c
CHIP_CSRCS += glue/vendor_sources/wpa_ctrl_iface.c
CHIP_CSRCS += glue/vendor_sources/wpas_main_supplicant.c
endif

CHIP_CSRCS += glue/vendor_sources/bk_rf_adapter.c
CHIP_CSRCS += glue/vendor_sources/bk_phy_api.c
CHIP_CSRCS += glue/vendor_sources/bk_phy_notify.c

endif
